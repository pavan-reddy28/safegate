# SafeGate 100% On-Device Zero-Leakage Backend Configuration
# Copy this file to .env and adjust values for your environment.

NODE_ENV=development

# On a parent's phone, set HOST=127.0.0.1 so the API is strictly local to the device.
# In container / cloud preview environments, 0.0.0.0:3000 is used.
HOST=0.0.0.0
PORT=3000

# Comma-separated local frontend origins permitted via CORS
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of extra domains to block locally (e.g. bad.example,scam.xyz)
LOCAL_BLOCKED_DOMAINS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Optional Keystore-backed HMAC secret (>=32 chars) for redirect tokens across restarts
REDIRECT_SIGNING_SECRET=

# Optional path to locally cached signed offline threat feed JSON manifest (zero egress)
OFFLINE_THREAT_FEED_PATH=

# SafeGate Cloud Platform sync & requestId override check (for APK / Vite builds)
VITE_SAFEGATE_PLATFORM_URL=https://api.pavanserver.me
VITE_SAFEGATE_APP_ID=com.safegate.app
VITE_APP_INGEST_KEY=
VITE_EVENT_PROOF_HMAC_SECRET=

