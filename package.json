{
  "name": "safegateway",
  "version": "1.0.0",
  "description": "Safegateway is the application which helps phones to protect from malicious url which leads to getting hacked. It presevnets this.",
  "license": "ISC",
  "author": "PAVAN REDDY",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test",
    "build": "node -e \"const fs=require('fs'),cp=require('child_process');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(d+'/'+e.name):e.name.endsWith('.js')?[d+'/'+e.name]:[]);for(const f of walk('src'))cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'});\"",
    "lint": "node -e \"const fs=require('fs'),cp=require('child_process');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(d+'/'+e.name):e.name.endsWith('.js')?[d+'/'+e.name]:[]);for(const f of [...walk('src'),...walk('tests')])cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'});\"",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "tldts": "^7.4.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
