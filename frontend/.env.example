# SafeGate Dashboard BFF + React Container Environment Example (NEVER commit real secrets)
NODE_ENV=production
PORT=4318
TRUST_PROXY=true
PLATFORM_BASE_URL=http://platform:4317
COOKIE_SECURE=true

# Layer 1: Azure Key Vault (fetches active operator token directly inside the VM container)
KEYVAULT_URL=https://your-keyvault-name.vault.azure.net
TOKEN_1H_SECRET_NAME=safegate-api-token-1h
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Layer 2: Single-Owner Login Authentication (only pavanreddy allowed)
OPERATOR_USERNAME=pavanreddy
OPERATOR_PASSWORD_HASH=scrypt$salt_hex$hash_hex
SESSION_SECRET=replace-with-at-least-32-chars-random-hex-secret
SESSION_TTL_SECONDS=43200
